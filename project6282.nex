BEGIN mrbayes;

	calibrate 
Zodiolestes	 = unif(19.2,23.0) 
Ferinestrix_rapax=unif(3.2,3.8)
Arctonyx=unif(0,1)
Meles_magnum=unif(2,2.5)
Meles_teihardi=unif(1.8,2.5)
Meles_chiai=unif(2,3.7)
Meles_leucurus=unif(0,0.6)
Meles_minor=unif(2,2.5)
Meles_thorali=unif(1.8,3)
Meles_meles =unif(0,1)
Arctomeles=unif(4,6)
Melodon_incertum=unif(5.3,7.5)
Melodon_majori=unif(5.3,7.5)
Promeles_palaeattica=unif(7.4,8)
Parataxidea_crassa_Zdansky =unif(5.3,7.5)
Parataxidea_sinensis_Zdansky =unif(5.3,7.5)
Adroverictis_ginsburgi =unif(7.4,8)
Iranictis_polaki=unif(8,8.9)
Taxodon_sansaniensis=unif(13.1,14.2)
Polgardia_pannonica=unif(5.3,7.4)
Archaeomeles_neglecta=unif(7.4,8)
Rhodanictis_depereti =unif(11.2,13.1)
Taxidea_taxus = fixed(0)         
Pliotaxidea_garberi = unif(5.8,6.5)
Chamitataxus_avitus  =  unif(5.8,6.5)

;

 constraint node1 partial = Taxidea_taxus  Meles_leucurus Meles_meles Arctonyx : Zodiolestes;
constraint node2 partial = Meles_leucurus Meles_meles Arctonyx : Zodiolestes Taxidea_taxus;
constraint node3 partial = Meles_leucurus Meles_meles Arctonyx : Zodiolestes Taxidea_taxus ;
constraint node4 partial = Meles_leucurus Meles_meles : Zodiolestes Taxidea_taxus Arctonyx;


	constraint root = 2-25;
    prset topologypr = constraints(root, node1,node2,node3,node4);
	prset nodeagepr = calibrated;
	prset brlenspr = clock:fossilization;
	prset clockratepr = lognorm(-7,0.6);
	prset clockvarpr = tk02;
    prset tk02varpr = exp(1);
	prset fossilizationpr = beta(1,1);
	prset samplestrat = diversity ;
	prset sampleprob = 0.25;
	prset speciationpr = exp(10);
	prset extinctionpr = beta(1,1);
	prset fossilizationpr = beta(1,1);[sai/sai+miu]
	prset treeagepr = offsetexp(16,23);
	unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all); 
	prset applyto=(all) ratepr=variable;
	mcmcp ngen= 10000000 relburnin=yes burninfrac=0.25 printfreq=1000  samplefreq=1000 nchains=4 savebrlens=yes temp=0.1;
	mcmc;
	sump;
	sumt Contype = Allcompat;
ENDBLOCK;
