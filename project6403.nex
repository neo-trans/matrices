TEXT CHARACTER=256 TAXON=73 TEXT='Following Nesbitt (2011: character 94) (MDE, 5 March 2014).';
TEXT CHARACTER=256 TAXON=151 TEXT='Based on SAM-PK-7696 (MDE, 16 March 2015).';
TEXT CHARACTER=256 TAXON=187 TEXT='Poorly preserved in the inferior anterior process (ISI, MDE 22 September 2015).';
